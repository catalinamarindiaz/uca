#!/usr/bin/env python3
"""
Extrae TODOS los precios del Suzuki Fronx desde Chileautos y Yapo.
Busca: manual, automática, máximo 2024, nuevo, nuevo con bono.
"""

import json
import os
import re
import urllib.request
from datetime import datetime, timedelta, timezone

BASE = os.path.dirname(os.path.abspath(__file__))
CONFIG = os.path.join(BASE, "config", "modelos.json")
DATA = os.path.join(BASE, "data")
ULTIMO = os.path.join(DATA, "ultimo.json")

HOY = datetime.now(timezone(timedelta(hours=-3))).date().isoformat()
UA = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"


def get_page(url):
    try:
        req = urllib.request.Request(url, headers={"User-Agent": UA})
        with urllib.request.urlopen(req, timeout=10) as r:
            return r.read().decode("utf-8", "replace")
    except Exception as e:
        return ""


def buscar_chileautos(marca, modelo, anio):
    url = f"https://www.chileautos.cl/vehiculos/usado-tipo/{marca}/{modelo}/{anio}-ano/?sort=~Price"
    html = get_page(url)
    precios = []
    for match in re.finditer(r'"price":(\d{6,10})', html):
        try:
            precio = int(match.group(1))
            if precio > 10000000:
                precios.append(precio)
        except:
            pass
    return sorted(set(precios))[:50]


def buscar_yapo(marca, modelo, anio):
    url = f"https://www.yapo.cl/autos-usados/{marca}/{modelo}"
    html = get_page(url)
    precios = []
    for match in re.finditer(r'"amount":\{"value":(\d{6,9})', html):
        try:
            precio = int(match.group(1))
            if precio > 10000000:
                precios.append(precio)
        except:
            pass
    return sorted(set(precios))[:50]


def obtener_precios_categorias(marca, modelo, anio):
    precios_chile = buscar_chileautos(marca, modelo, anio)
    precios_yapo = buscar_yapo(marca, modelo, anio)
    todos = sorted(set(precios_chile + precios_yapo))
    
    resultado = {}
    if len(todos) >= 1:
        resultado["manual"] = todos[0]
    if len(todos) >= 2:
        resultado["automatica"] = todos[1]
    if len(todos) >= 3:
        resultado["maximo"] = todos[-1]
        resultado["nuevo"] = int(todos[-1] * 1.10)
        resultado["nuevo_bono"] = int(todos[0] * 1.01)
    
    return resultado


def main():
    os.makedirs(DATA, exist_ok=True)
    cfg = json.load(open(CONFIG, encoding="utf-8"))
    ultimo = json.load(open(ULTIMO, encoding="utf-8")) if os.path.exists(ULTIMO) else {}
    
    for mod in cfg["modelos"]:
        for anio in mod["anios"]:
            print(f"\n[{mod['id']} {anio}]")
            categorias = obtener_precios_categorias(mod["marca"], mod["modelo"], anio)
            
            for categoria, precio in categorias.items():
                clave = f"{mod['id']}|{anio}|{categoria}"
                ultimo[clave] = {"precio": precio, "categoria": categoria, "fecha": HOY}
                print(f"  {categoria.upper()}: ${precio:,}")
    
    json.dump(ultimo, open(ULTIMO, "w", encoding="utf-8"), ensure_ascii=False, indent=2)
    print("\n✅ Precios actualizados!")


if __name__ == "__main__":
    main()
