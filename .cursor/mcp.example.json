{
  "_comment": "Ejemplo de configuracion MCP. La config real va en ~/.cursor/mcp.json (Settings > MCP). NO subas claves reales al repo.",
  "mcpServers": {
    "clickup": {
      "url": "https://mcp.clickup.com/mcp",
      "_notas": "Plugin oficial ClickUp (Marketplace) o entrada manual. OAuth en primer uso. Ver 04-conectores/clickup.md"
    },
    "gtm": {
      "url": "https://mcp.gtmeditor.com/authorize",
      "_notas": "Requiere OAuth en Settings > MCP"
    },
    "skalling-wordpress": {
      "command": "npx",
      "args": ["-y", "@automattic/mcp-wordpress-remote@latest"],
      "env": {
        "WP_API_URL": "https://TU-SITIO/wp-json/mcp/mcp-adapter-default-server",
        "WP_API_USERNAME": "TU_USUARIO",
        "WP_API_PASSWORD": "TU_APP_PASSWORD"
      }
    },
    "trends": {
      "url": "https://api.trendsmcp.ai/mcp",
      "headers": {
        "Authorization": "Bearer TU_API_KEY_DE_TRENDSMCP"
      },
      "_notas": "Opcional de pago; preferir 04-conectores/scripts/tendencias.py"
    }
  }
}
