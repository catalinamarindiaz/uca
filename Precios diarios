#!/usr/bin/env python3
"""Extrae el precio más barato de autos usados desde Chileautos y Yapo."""

import json
import os
import re
import urllib.request
from datetime import datetime, timedelta, timezone

BASE = os.path.dirname(os.path.abspath(__file__))
CONFIG = os.path.join(BASE, "config", "modelos.json")
DATA = os.path.join(BASE, "data")
ULTIMO = os.path.join(DATA, "ultimo.json")

HOY = datetime.now(timezone(timedelta(hours=-3))).date().isoformat()
UA = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"


def get_page(url):
    """Descarga una página."""
    try:
        req = urllib.request.Request(url, headers={"User-Agent": UA})
        with urllib.request.urlopen(req, timeout=10) as r:
            return r.read().decode("utf-8", "replace")
    except Exception as e:
        print(f"  Error: {e}")
        return ""


def buscar_chileautos(marca, modelo, anio):
    """Extrae precios de Chileautos."""
    url = f"https://www.chileautos.cl/vehiculos/usado-tipo/{marca}/{modelo}/{anio}-ano/?sort=~Price"
    html = get_page(url)
    precios = []

    for match in re.finditer(r'"price":(\d{6,10})', html):
        try:
            precio = int(match.group(1))
            if precio > 1000000:  # Al menos 1 millón
                precios.append(precio)
        except:
            pass

    return sorted(set(precios))[:20]  # Top 20 únicos


def buscar_yapo(marca, modelo, anio):
    """Extrae precios de Yapo."""
    url = f"https://www.yapo.cl/autos-usados/{marca}/{modelo}"
    html = get_page(url)
    precios = []

    for match in re.finditer(r'"amount":\{"value":(\d{6,9})', html):
        try:
            precio = int(match.group(1))
            if precio > 1000000:  # Al menos 1 millón
                precios.append(precio)
        except:
            pass

    return sorted(set(precios))[:20]  # Top 20 únicos


def main():
    """Ejecuta la extracción en ambos portales."""
    os.makedirs(DATA, exist_ok=True)

    cfg = json.load(open(CONFIG, encoding="utf-8"))
    ultimo = json.load(open(ULTIMO, encoding="utf-8")) if os.path.exists(ULTIMO) else {}

    for mod in cfg["modelos"]:
        for anio in mod["anios"]:
            print(f"[{mod['id']} {anio}]")

            # Busca en Chileautos
            precios_chile = buscar_chileautos(mod["marca"], mod["modelo"], anio)
            print(f"  Chileautos: {len(precios_chile)} precios encontrados")

            # Busca en Yapo
            precios_yapo = buscar_yapo(mod["marca"], mod["modelo"], anio)
            print(f"  Yapo: {len(precios_yapo)} precios encontrados")

            # Combina ambos
            todos_precios = precios_chile + precios_yapo

            clave = f"{mod['id']}|{anio}"
            if len(todos_precios) >= 2:
                precio_minimo = min(todos_precios)
                # Determina de cuál portal es
                if precio_minimo in precios_chile:
                    fuente = "Chileautos"
                else:
                    fuente = "Yapo"

                ultimo[clave] = {
                    "precio_desde": precio_minimo,
                    "fuente": fuente,
                    "total_avisos": len(todos_precios),
                    "fecha": HOY
                }
                print(f"  ✓ Precio mínimo: ${precio_minimo:,} ({fuente})")
            else:
                print(f"  ✗ Sin suficientes precios")

    json.dump(ultimo, open(ULTIMO, "w", encoding="utf-8"), ensure_ascii=False, indent=2)
    print("\n✅ Actualización completada!")


if __name__ == "__main__":
    main()
